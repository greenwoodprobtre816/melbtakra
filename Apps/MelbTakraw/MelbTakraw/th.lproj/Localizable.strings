"trainer.scenario.1.replay.1" = "The pressure starts on the left front lane, where the first touch is drifting tight to the net.";
"trainer.scenario.1.replay.2" = "As the feeder, your job is to turn a messy receive into a clean attackable picture.";
"trainer.scenario.1.replay.3" = "The winning lane is the fast net set that keeps the killer on time before the block resets.";
"trainer.scenario.2.replay.1" = "The ball is already living on your side, so the first read is about body balance rather than pure reach.";
"trainer.scenario.2.replay.2" = "The setup should preserve your angle so you can attack without losing the lane.";
"trainer.scenario.2.replay.3" = "The right-front finish works because it uses the open picture instead of forcing a cross-body miracle.";
"trainer.scenario.3.replay.1" = "Everything begins in the service circle, where control matters more than flair.";
"trainer.scenario.3.replay.2" = "The serving motion should keep the regu organized for the next touch, not just create speed.";
"trainer.scenario.3.replay.3" = "Holding the service line keeps the opening shape stable and prevents immediate over-rotation.";
"trainer.scenario.4.replay.1" = "Net pressure is already high, so the first responsibility is not to over-commit.";
"trainer.scenario.4.replay.2" = "A smart transition touch buys the regu one cleaner frame instead of gambling on a blocked strike.";
"trainer.scenario.4.replay.3" = "Resetting to the center gives the whole team a chance to attack from balance on the next contact.";
"trainer.scenario.5.replay.1" = "The left lane is crowded, so reading the squeeze early matters.";
"trainer.scenario.5.replay.2" = "The feeder's best touch opens the central recovery channel instead of chasing a low-percentage quick hit.";
"trainer.scenario.5.replay.3" = "That central release restores enough structure for the next athlete to play with options again.";
"trainer.scenario.6.replay.1" = "The pressure point is at the tape, where rushed decisions usually collapse the sequence.";
"trainer.scenario.6.replay.2" = "A composed feeder touch bends the play back toward a cleaner right-side picture.";
"trainer.scenario.6.replay.3" = "The right-front target works because it rebuilds timing before the defense can settle.";
"trainer.scenario.7.replay.1" = "As Tekong, the first read is whether the serve can distort the receiving shape toward the right lane.";
"trainer.scenario.7.replay.2" = "The service action should stay balanced enough to support the next sequence, not only create speed.";
"trainer.scenario.7.replay.3" = "The right-front finish is earned because the opening move already bent the regu into that corridor.";
"trainer.scenario.8.replay.1" = "This is an unstable net moment, so the first task is to keep the rally alive without losing shape entirely.";
"trainer.scenario.8.replay.2" = "The feeder's touch should feel conservative, but it is actually a high-level recovery choice.";
"trainer.scenario.8.replay.3" = "By using the center, the regu resets its geometry and earns another chance to attack on cleaner terms.";
"trainer.scenario.9.replay.1" = "The play begins with a loaded right side, which invites the defense to lean too heavily in one direction.";
"trainer.scenario.9.replay.2" = "The setup must preserve enough disguise for the killer to attack across the body without telegraphing it early.";
"trainer.scenario.9.replay.3" = "The left-front finish becomes available because the sequence first sold commitment to the opposite side.";

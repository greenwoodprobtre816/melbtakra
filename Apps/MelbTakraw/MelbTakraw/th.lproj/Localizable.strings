"learn.topic.foundations.title" = "พื้นฐานของคอร์ต";
"learn.topic.foundations.summary" = "เข้าใจการจัดวาง regu จุดเริ่มต้นของแรงกดดัน และเหตุผลที่วินัยในการสัมผัสกำหนดรูปแบบของเกม";
"learn.topic.foundations.p1" = "regu มาตรฐานมีผู้เล่นสามคนและคอร์ตที่กะทัดรัดซึ่งต้องการการรับรู้พื้นที่อย่างรวดเร็ว ต่างจากกีฬาตาข่ายกระแสหลัก ตะกร้อลดเวลาและการตัดสินใจลงเหลือเพียงไม่กี่จังหวะสัมผัสที่รวดเร็ว";
"learn.topic.foundations.p2" = "ก้าวแรกของการเรียนรู้คือการเข้าใจความสัมพันธ์ระหว่างวงเสิร์ฟ เลนด้านหน้า และแรงกดดันที่หน้าเน็ต เมื่อมองเห็นเรขาคณิตนี้ เกมจะเริ่มอ่านออกเป็นแพตเทิร์น";
"learn.topic.foundations.p3" = "นี่คือส่วนที่เปลี่ยนผู้ชมหน้าใหม่ให้กลายเป็นคนที่ตามแต้มได้อย่างเข้าใจ ไม่ใช่แค่จำกติกา แต่เห็นว่าทำไมกติกาแต่ละข้อจึงมีอยู่";
"learn.topic.foundations.b1" = "การสัมผัสทั้งสามครั้งมีค่า ทุกจังหวะต้องช่วยคงสมดุลหรือสร้างความได้เปรียบ";
"learn.topic.foundations.b2" = "รูปทรงของคอร์ตสำคัญ เพราะการขยับเพียงเล็กน้อยอาจเปิดหรือปิดเลนบุกได้";
"learn.topic.foundations.b3" = "ช่วงเสิร์ฟมีเจตนาทางแท็กติกตั้งแต่ต้น ไม่ใช่แค่การเริ่มเล่น";
"learn.topic.roles.title" = "สถาปัตยกรรมของบทบาท";
"learn.topic.roles.summary" = "มอง Tekong, Feeder และ Killer เป็นระบบร่วมกัน ไม่ใช่ป้ายชื่อที่แยกขาด";
"learn.topic.roles.p1" = "Tekong ไม่ได้เป็นแค่คนเสิร์ฟ เขาควบคุมจังหวะ ความกดดันตอนเปิดเกม และความมั่นใจของทั้งทีม";
"learn.topic.roles.p2" = "Feeder คือศูนย์กลางการคิดของ regu ผู้เล่นคนนี้เปลี่ยนจังหวะที่เสียรูปให้กลับมาเป็นโครงสร้างที่เล่นต่อได้";
"learn.topic.roles.p3" = "Killer คือผู้ปิดแต้ม แต่การจบจะเกิดขึ้นได้ก็ต่อเมื่อสองบทบาทแรกสร้างจังหวะและความสูงให้พร้อม";
"learn.topic.roles.b1" = "Tekong กำหนดโทนของ rally ตั้งแต่เฟรมแรก";
"learn.topic.roles.b2" = "Feeder คือสมองเพลย์เมกเกอร์ที่คืนระเบียบภายใต้แรงกดดัน";
"learn.topic.roles.b3" = "Killer เปลี่ยนโครงสร้างให้กลายเป็นไฮไลต์เมื่อทุกอย่างถูกเตรียมไว้แล้ว";
"learn.topic.matchiq.title" = "ไอคิวของแมตช์";
"learn.topic.matchiq.summary" = "อ่านแนวโน้ม ฟื้นรูปทรงทีม และเข้าใจว่าเมื่อใดทีมระดับสูงเลือกการคุมเกมมากกว่าความเสี่ยงแบบโชว์";
"learn.topic.matchiq.p1" = "ตะกร้อดูระเบิดพลัง แต่การตัดสินใจระดับสูงมักสุขุมในจังหวะที่เหมาะสม ทีมที่แข็งแกร่งรู้ว่าเมื่อใดควรรีเซ็ต เมื่อใดควรหน่วง และเมื่อใดควรโจมตีเลนที่เปิด";
"learn.topic.matchiq.p2" = "นี่คือจุดที่แอปก้าวพ้นการเป็นสารานุกรมนิ่ง ๆ เพราะสอนให้ผู้ใช้เห็นว่าแรงกดดันเคลื่อนที่อย่างไรในแต่ละ rally";
"learn.topic.matchiq.p3" = "หากผู้ใช้ระบุได้ว่าทำไมการหน่วงเซ็ตหรือการคืนบอลอย่างปลอดภัยจึงเป็นคำตอบที่ดีที่สุด เขาจะกลายเป็นผู้อ่านเกมเชิงแท็กติกอย่างแท้จริง";
"learn.topic.matchiq.b1" = "จังหวะแข็งแกร่งไม่จำเป็นต้องดุดันเสมอ หลายครั้งคือการเลือกที่ช่วยคงโครงสร้าง";
"learn.topic.matchiq.b2" = "รูปทรงร่างกายและแนวโน้มสามารถบอกเลนถัดไปได้ก่อนสัมผัสบอล";
"learn.topic.matchiq.b3" = "การรีเซ็ตโครงสร้างคือการตัดสินใจระดับสูง ไม่ใช่ความลังเล";
"history.explore.header" = "เข้าสู่เรื่องราวทางวัฒนธรรมแบบเต็ม";
"history.detail.keypoints" = "ประเด็นประวัติศาสตร์สำคัญ";
"history.story.origins.title" = "จุดกำเนิดและมรดกร่วม";
"history.story.origins.summary" = "ติดตามว่าการเล่นลูกเตะร่วมกันพัฒนาเป็นหนึ่งในกีฬาสมัยใหม่ที่โดดเด่นที่สุดของเอเชียตะวันออกเฉียงใต้ได้อย่างไร";
"history.story.origins.p1" = "ก่อนที่ตะกร้อจะถูกทำให้เป็นกีฬาสมัยใหม่ การเล่นบอลด้วยเท้าได้มีอยู่แล้วในราชสำนัก หมู่บ้าน และชุมชนทั่วภูมิภาค";
"history.story.origins.p2" = "เสน่ห์ของเรื่องราวจุดกำเนิดอยู่ที่การผสมกันของพิธีกรรม การโชว์ทักษะ และการเล่นในสังคม ลูกหวาย ถิ่นกำเนิด และตรรกะของคอร์ตล้วนหล่อหลอมตัวตนของกีฬา";
"history.story.origins.p3" = "สำหรับผู้ชมทั่วโลก ประวัติศาสตร์นี้ทำให้กีฬามีความหมายมากกว่าแค่คลิปไวรัล และทำให้ Melb Takraw เป็นสะพานเชื่อมระหว่างมรดก งานฝีมือ และความเข้าใจเกมสมัยใหม่";
"history.story.origins.b1" = "การเล่นแบบตะกร้อในช่วงแรกมีรากฐานจากชุมชนและภูมิภาคก่อนจะถูกทำให้เป็นมาตรฐาน";
"history.story.origins.b2" = "วัฒนธรรมงานฝีมือ โดยเฉพาะลูกหวายสาน ยังเป็นส่วนหนึ่งของอัตลักษณ์กีฬา";
"history.story.origins.b3" = "บริบททางประวัติศาสตร์ทำให้ผู้ชมหน้าใหม่มีเหตุผลที่จะสนใจมากขึ้น";
"history.story.regional.title" = "พลังระดับภูมิภาคและอัตลักษณ์ของชาติ";
"history.story.regional.summary" = "ดูว่าไทย มาเลเซีย และประเทศเพื่อนบ้านช่วยผลักดันให้ตะกร้อกลายเป็นกีฬาการแข่งขันที่มองเห็นและรู้สึกได้ลึกเพียงใด";
"history.story.regional.p1" = "ประเทศไทยกลายเป็นบ้านสมัยใหม่ที่สำคัญของตะกร้อจากการมองเห็นซ้ำ ความคุ้นเคยในสาธารณะ และความมั่นใจทางวัฒนธรรม";
"history.story.regional.p2" = "มาเลเซียก็มีบทบาทสำคัญในการสร้างรูปแบบการแข่งขันและฐานผู้ชมที่เหนียวแน่น ทำให้ตะกร้อกลายเป็นมาตรฐานร่วมของภูมิภาค";
"history.story.regional.p3" = "การกระจุกตัวในภูมิภาคนี้สำคัญต่อเชิงกลยุทธ์ของแอป เพราะทำให้ผลิตภัณฑ์ดูเฉพาะทางในระดับโลก แต่มีคุณค่าลึกซึ้งในตลาดหลัก";
"history.story.regional.b1" = "ความแข็งแรงระดับภูมิภาคทำให้กีฬานี้ต่อเนื่องก่อนที่โลกดิจิทัลจะตามทัน";
"history.story.regional.b2" = "อัตลักษณ์ชาติและความภูมิใจท้องถิ่นช่วยรักษาความสนใจของผู้ชม";
"history.story.regional.b3" = "ผลิตภัณฑ์หลายภาษาสามารถเชื่อมตลาดหลักเดิมกับตลาดค้นพบใหม่ได้";
"history.story.modern.title" = "ช่องว่างของภาพลักษณ์สมัยใหม่";
"history.story.modern.summary" = "ตะกร้อมีดราม่าภาพระดับโลกแล้ว แต่ยังขาดผลิตภัณฑ์ดิจิทัลคุณภาพสูงที่อธิบายเกมได้ดี";
"history.story.modern.p1" = "การถ่ายทอดสมัยใหม่และโซเชียลมีเดียทำให้ตะกร้อสะดุดตาทันที ทั้งลูกตีแบบอะโครแบติก การเซฟที่แทบเป็นไปไม่ได้ และจังหวะที่เฉียบคม";
"history.story.modern.p2" = "ปัญหาคือการเปลี่ยนความตื่นเต้นให้กลายเป็นความเข้าใจ ภาพสวยเพียงอย่างเดียวไม่ได้บอกว่าทำไมการตัดสินใจนั้นจึงฉลาด และนี่คือจุดที่ Melb Takraw เข้ามาเติมเต็ม";
"history.story.modern.p3" = "ด้วยการรวมภาพ บทความ และเทรนเนอร์ที่เข้าใจง่าย แอปสามารถกลายเป็นชั้นนำทางให้ผู้ใช้เข้าใจตัวกีฬาจริง ๆ";
"history.story.modern.b1" = "ตะกร้อดึงความสนใจด้วยภาพได้อยู่แล้ว แต่ยังต้องการเครื่องมือช่วยตีความ";
"history.story.modern.b2" = "การเรียนรู้และภาพลักษณ์เร้าใจทำงานร่วมกันได้ดีที่สุดเมื่อ UI พาสายตาผู้ใช้ไปถูกทาง";
"history.story.modern.b3" = "ผลิตภัณฑ์กีฬานิชมูลค่าสูงเมื่อมันสอนบริบท ไม่ใช่แค่ข้อเท็จจริง";
"trainer.visual.header" = "อ่านคอร์ต";

"learn.topic.foundations.timeline.3.title" = "Detecta el carril temprano";
"learn.topic.foundations.timeline.3.body" = "Los mejores observadores identifican por dónde viajará el ataque antes del remate final.";
"learn.topic.roles.readingTime" = "8 min de lectura";
"learn.topic.roles.gallery.1" = "El rol que define el punto se ve, pero la cadena de preparación detrás importa igual.";
"learn.topic.roles.gallery.2" = "El Tekong fija el marco emocional del rally.";
"learn.topic.roles.gallery.3" = "En nivel élite, la claridad de roles suele decidir quién mantiene la calma en intercambios largos.";
"learn.topic.roles.timeline.1.label" = "01";
"learn.topic.roles.timeline.1.title" = "Abre con control";
"learn.topic.roles.timeline.1.body" = "El Tekong crea una primera imagen limpia e intencional.";
"learn.topic.roles.timeline.2.label" = "02";
"learn.topic.roles.timeline.2.title" = "Convierte el caos";
"learn.topic.roles.timeline.2.body" = "El Feeder restablece el orden y presenta el mejor carril.";
"learn.topic.roles.timeline.3.label" = "03";
"learn.topic.roles.timeline.3.title" = "Cierra el patrón";
"learn.topic.roles.timeline.3.body" = "El Killer ataca cuando el tiempo y el espacio están alineados.";
"learn.topic.matchiq.readingTime" = "9 min de lectura";
"learn.topic.matchiq.gallery.1" = "El Takraw moderno genera drama visual al instante, pero entenderlo requiere contexto.";
"learn.topic.matchiq.gallery.2" = "La geometría de la cancha y la forma del equipo explican por qué algunos toques tranquilos son de élite.";
"learn.topic.matchiq.gallery.3" = "El remate destacado solo tiene sentido cuando entiendes las dos decisiones anteriores.";
"learn.topic.matchiq.timeline.1.label" = "01";
"learn.topic.matchiq.timeline.1.title" = "Lee el punto de presión";
"learn.topic.matchiq.timeline.1.body" = "Detecta al jugador o la zona donde el rally empieza a romperse.";
"learn.topic.matchiq.timeline.2.label" = "02";
"learn.topic.matchiq.timeline.2.title" = "Conserva opciones";
"learn.topic.matchiq.timeline.2.body" = "Los equipos fuertes eligen toques que mantengan vivas varias acciones siguientes.";
"learn.topic.matchiq.timeline.3.label" = "03";
"learn.topic.matchiq.timeline.3.title" = "Ataca cuando el carril esté ganado";
"learn.topic.matchiq.timeline.3.body" = "La mejor definición suele llegar después de un reinicio paciente de la forma.";
"learn.topic.service_design.title" = "Diseño del servicio";
"learn.topic.service_design.summary" = "Explora cómo la altura del saque, el disimulo y la presión del primer contacto enmarcan todo el punto antes de que el público lo note.";
"learn.topic.service_design.readingTime" = "6 min de lectura";
"learn.topic.service_design.p1" = "El servicio en Takraw no es un reinicio neutro. Es una jugada de apertura diseñada que introduce ritmo, trayectoria y presión emocional en una sola acción.";
"learn.topic.service_design.p2" = "El diseño del saque combina mecánica corporal con relato táctico. Pequeñas variaciones en el lanzamiento, la cadera o la altura del contacto obligan al rival a ajustar su forma antes de tiempo.";
"learn.topic.service_design.p3" = "Una forma útil de estudiar el servicio es preguntar qué tipo de segundo toque provoca. Un saque intimidante que regala una recepción cómoda vale menos que uno disciplinado que dobla el siguiente contacto.";
"learn.topic.service_design.p4" = "Dentro del producto, este tema conecta fundamentos con inteligencia de juego. Demuestra que incluso el primer toque puede analizarse como diseño y no solo como técnica.";
"learn.topic.service_design.b1" = "Un saque debe juzgarse por la forma que obliga después, no solo por lo espectacular que parece.";
"learn.topic.service_design.b2" = "El engaño y el timing importan porque el receptor reacciona antes de que el balón complete su viaje.";
"learn.topic.service_design.b3" = "La presión del servicio es la primera palanca táctica disponible en cada rally.";
"learn.topic.service_design.gallery.1" = "La postura del saque revela pistas mucho antes de que la pelota cruce la red.";
"learn.topic.service_design.gallery.2" = "La presión sobre los carriles suele empezar por dónde empuja el saque a la unidad receptora.";
"learn.topic.service_design.gallery.3" = "A ritmo de campeonato, un saque bien diseñado puede definir el tono emocional del set.";
"learn.topic.service_design.timeline.1.label" = "01";
"learn.topic.service_design.timeline.1.title" = "Da forma al lanzamiento";
"learn.topic.service_design.timeline.1.body" = "Un lanzamiento estable ayuda a ocultar la intención y mantener el equilibrio corporal.";
"learn.topic.service_design.timeline.2.label" = "02";
"learn.topic.service_design.timeline.2.title" = "Fuerza la recepción";
"learn.topic.service_design.timeline.2.body" = "Los mejores saques doblan el primer retorno hacia un carril más débil.";
"learn.topic.service_design.timeline.3.label" = "03";
"learn.topic.service_design.timeline.3.title" = "Prepara el tercer toque";
"learn.topic.service_design.timeline.3.body" = "Un saque de calidad es en realidad una inversión en los dos contactos siguientes.";
"learn.topic.defensive_shapes.title" = "Formas defensivas";
"learn.topic.defensive_shapes.summary" = "Aprende cómo los regus de élite recuperan estructura, protegen el centro y convierten momentos desesperados en rallies vivos otra vez.";
"learn.topic.defensive_shapes.readingTime" = "8 min de lectura";
"learn.topic.defensive_shapes.p1" = "La defensa en Takraw suele entenderse mal porque la vista del aficionado sigue naturalmente el remate espectacular. Sin embargo, los equipos que más duran son los que recuperan forma más rápido después de un toque comprometido.";
"learn.topic.defensive_shapes.p2" = "La primera regla defensiva es proteger el centro de la cancha sin abandonar los carriles delanteros. Ese equilibrio es difícil porque cada paso negocia entre seguridad y amenaza.";
"learn.topic.defensive_shapes.p3" = "Las buenas formas defensivas también dependen de la confianza. Si el Feeder sabe que el Tekong cubrirá el bolsillo de recuperación, puede arriesgar una redirección más inteligente.";
"learn.topic.defensive_shapes.p4" = "Este tema importa en la app porque aporta realismo emocional al trainer. Muchos escenarios no tratan del gesto más vistoso, sino del que reconstruye estructura más rápido.";
"learn.topic.defensive_shapes.b1" = "Defender es restaurar opciones, no solo mantener viva la pelota.";
"learn.topic.defensive_shapes.b2" = "El carril central de recuperación suele ser la prioridad oculta en los rallies inestables.";
"learn.topic.defensive_shapes.b3" = "Una buena decisión defensiva preserva la opción de atacar en el contacto siguiente.";
"learn.topic.defensive_shapes.gallery.1" = "La defensa de élite se ve en la rapidez con la que un regu recompone su forma.";
"learn.topic.defensive_shapes.gallery.2" = "Incluso los ataques más espectaculares empiezan porque alguien recuperó la estructura primero.";
"learn.topic.defensive_shapes.gallery.3" = "La identidad acrobática del deporte siempre ha convivido con una sorprendente capacidad de control.";
"learn.topic.defensive_shapes.timeline.1.label" = "01";
"learn.topic.defensive_shapes.timeline.1.title" = "Protege el medio";
"learn.topic.defensive_shapes.timeline.1.body" = "La primera idea de recuperación suele ser reabrir el carril central.";
"learn.topic.defensive_shapes.timeline.2.label" = "02";
"learn.topic.defensive_shapes.timeline.2.title" = "Asigna el rescate";
"learn.topic.defensive_shapes.timeline.2.body" = "La confianza de roles decide quién estabiliza y quién prepara el siguiente patrón.";
"learn.topic.defensive_shapes.timeline.3.label" = "03";
"learn.topic.defensive_shapes.timeline.3.title" = "Contraataca desde el equilibrio";
"learn.topic.defensive_shapes.timeline.3.body" = "Un rally vuelve a ser peligroso cuando regresa la forma.";
"history.story.origins.readingTime" = "8 min de lectura";
"history.story.origins.accent" = "Raíces";
"history.story.origins.gallery.1" = "La herencia compartida es uno de los rasgos más distintivos del deporte.";
"history.story.origins.gallery.2" = "El juego comunitario moldeó el ritmo y el sentido social de las primeras formas.";
"history.story.origins.gallery.3" = "La pelota tejida conecta la acción física con la tradición material.";

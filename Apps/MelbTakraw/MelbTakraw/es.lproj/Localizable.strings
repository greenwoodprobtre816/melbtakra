"trainer.scenario.1.title" = "La devolución queda inestable tras un saque corto.";
"trainer.scenario.1.prompt" = "Eres el Feeder. ¿Qué le da a tu equipo la mejor ventana de ataque?";
"trainer.scenario.1.option.1" = "Levantar la pelota con limpieza hacia la red para un ángulo de remate controlado.";
"trainer.scenario.1.option.2" = "Forzar un golpe apresurado en el segundo toque desde una posición incómoda.";
"trainer.scenario.1.option.3" = "Enviar la pelota hacia atrás sin ninguna estructura ofensiva.";
"trainer.scenario.1.feedback" = "Una preparación tranquila crea un ataque real. El trabajo del Feeder es convertir el caos en una pelota rematable.";
"trainer.scenario.2.title" = "El rival sigue atacando en diagonal después de una asistencia alta.";
"trainer.scenario.2.prompt" = "¿Qué debe hacer tu equipo antes del siguiente contacto?";
"trainer.scenario.2.option.1" = "Retroceder y dejar desprotegido el espacio cerca de la red.";
"trainer.scenario.2.option.2" = "Desplazar la defensa hacia la diagonal y preparar el contraataque de inmediato.";
"trainer.scenario.2.option.3" = "Ignorar el patrón y esperar solo un error.";
"trainer.scenario.2.feedback" = "Leer tendencias forma parte del Takraw de élite. La precolocación te da oportunidad de defensa y contraataque.";
"trainer.scenario.3.title" = "El Tekong ha fallado dos saques seguidos.";
"trainer.scenario.3.prompt" = "¿Cuál es la mejor decisión de reinicio para el equipo?";
"trainer.scenario.3.option.1" = "Aumentar el riesgo y buscar un saque milagroso para recuperarse al instante.";
"trainer.scenario.3.option.2" = "Volver a un saque más estable y reconstruir el ritmo mediante el control.";
"trainer.scenario.3.option.3" = "Cambiar roles a mitad del rally sin señal ni preparación.";
"trainer.scenario.3.feedback" = "En los deportes de precisión, el impulso suele volver primero con estabilidad. El control reconstruye la confianza.";
"trainer.scenario.4.title" = "Tu Killer llega tarde a la asistencia y no puede atacar a máxima altura.";
"trainer.scenario.4.prompt" = "¿Cuál es la respuesta más inteligente del equipo?";
"trainer.scenario.4.option.1" = "Forzar el remate igualmente porque la pelota está cerca de la red.";
"trainer.scenario.4.option.2" = "Dejar que el rally se alargue y esperar un error rival.";
"trainer.scenario.4.option.3" = "Reciclar la pelota con seguridad y reconstruir el ataque en el siguiente patrón.";
"trainer.scenario.4.feedback" = "Los mejores equipos saben cuándo no forzar el remate. Reconstruir la secuencia suele ser la opción más inteligente.";
"trainer.scenario.5.title" = "Tu equipo ya usó dos toques y la pelota deriva hacia la línea.";
"trainer.scenario.5.prompt" = "¿Cuál es el contacto final más inteligente?";
"trainer.scenario.5.option.1" = "Enviar un retorno controlado y legal para alargar el rally.";
"trainer.scenario.5.option.2" = "Entrar en pánico y usar el brazo para llegar más lejos.";
"trainer.scenario.5.option.3" = "Dejar de moverse y permitir que caiga la pelota.";
"trainer.scenario.5.feedback" = "Cuando el conteo aprieta, el control legal importa más que el espectáculo.";
"trainer.scenario.6.title" = "El rival lee a tu Feeder y cierra la red temprano.";
"trainer.scenario.6.prompt" = "¿Cómo debe responder tu lado?";
"trainer.scenario.6.option.1" = "Repetir la misma asistencia rápida sin disimulo.";
"trainer.scenario.6.option.2" = "Forzar un remate de bajo porcentaje a través del bloqueo.";
"trainer.scenario.6.option.3" = "Usar una preparación con retraso para mover el tiempo y reabrir el carril.";
"trainer.scenario.6.feedback" = "Cambiar el ritmo suele ser más fuerte que forzar potencia.";
"trainer.scenario.7.title" = "Tu Tekong detecta que el receptor se inclina demasiado hacia dentro.";

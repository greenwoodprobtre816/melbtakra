"trainer.minigame.drill.3.failure" = "La opción vistosa tienta, pero antes hace falta control.";
"trainer.minigame.drill.4.prompt" = "La cinta está saturada. Redirige hacia el carril derecho más limpio.";
"trainer.minigame.drill.4.success" = "Gran toque. Moviste la jugada hacia el corredor derecho más claro.";
"trainer.minigame.drill.4.failure" = "Inténtalo en la siguiente ronda. El mejor carril está lejos de la presión de la cinta.";
"trainer.minigame.drill.5.prompt" = "La defensa sobrecarga un lado tras una secuencia caótica. ¿Qué rol debe castigar el carril de cambio?";
"trainer.minigame.drill.5.success" = "Sí. El Killer está mejor colocado para cerrar ese cambio disfrazado.";
"trainer.minigame.drill.5.failure" = "Todavía no. Piensa quién convierte el carril abierto en el remate final.";
"trainer.minigame.drill.6.prompt" = "El saque abrió la recepción y tu regu está equilibrado. ¿Qué patrón debe venir después?";
"trainer.minigame.drill.6.success" = "Perfecto. Construir mantiene al regu a tiempo y prepara el carril de definición.";

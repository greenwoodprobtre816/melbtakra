"history.story.origins.timeline.1.title" = "Juego de corte y comunidad";
"history.story.origins.timeline.1.body" = "Las tradiciones de pelota con el pie aparecen en entornos reales y comunales de toda la región.";
"history.story.origins.timeline.2.label" = "Premoderno";
"history.story.origins.timeline.2.title" = "Lenguaje visual compartido";
"history.story.origins.timeline.2.body" = "La pelota tejida y los intercambios circulares pasan a formar parte de una cultura reconocible.";
"history.story.origins.timeline.3.label" = "Era moderna";
"history.story.origins.timeline.3.title" = "Surge el deporte formal";
"history.story.origins.timeline.3.body" = "Las estructuras competitivas codifican un juego que sigue llevando memoria visual más antigua.";
"history.story.regional.readingTime" = "7 min de lectura";
"history.story.regional.accent" = "Rivales";
"history.story.regional.gallery.1" = "Los estadios modernos muestran cómo la inversión regional convirtió al Takraw en un deporte de gran escenario.";
"history.story.regional.gallery.2" = "El espectáculo atlético contemporáneo aún refleja una herencia claramente regional.";
"history.story.regional.gallery.3" = "La fortaleza nacional crece más fácilmente cuando ya existe familiaridad cultural.";
"history.story.regional.timeline.1.label" = "Crecimiento";
"history.story.regional.timeline.1.title" = "Apoyo institucional";
"history.story.regional.timeline.1.body" = "Escuelas, clubes y eventos hacen que el deporte pueda repetirse entre generaciones.";
"history.story.regional.timeline.2.label" = "Visibilidad";
"history.story.regional.timeline.2.title" = "Nacen audiencias nacionales";
"history.story.regional.timeline.2.body" = "La familiaridad televisiva crea mayor reconocimiento y aspiración.";
"history.story.regional.timeline.3.label" = "Identidad";
"history.story.regional.timeline.3.title" = "Se consolida el prestigio regional";
"history.story.regional.timeline.3.body" = "El Takraw se convierte en un motivo de orgullo público, no solo en un resultado.";
"history.story.sea_games.title" = "SEA Games y legitimidad competitiva";
"history.story.sea_games.summary" = "Sigue cómo la visibilidad multideportiva ayudó al Takraw a pasar de la familiaridad regional a un reconocimiento competitivo más amplio.";
"history.story.sea_games.readingTime" = "6 min de lectura";
"history.story.sea_games.p1" = "Los eventos multideportivos importan porque cambian la forma en que una disciplina se percibe públicamente. Allí, el Takraw se ve no solo como práctica cultural, sino como deporte de élite legítimo.";
"history.story.sea_games.p2" = "Los SEA Games ofrecieron exactamente ese escenario. Dieron una estructura repetible para la comparación, la inversión y la narrativa pública.";
"history.story.sea_games.p3" = "Esa visibilidad ayudó a estabilizar caminos para atletas y audiencias. La competencia constante crea héroes, rivalidades y memoria.";
"history.story.sea_games.p4" = "Para Melb Takraw esto importa porque la retención del producto también depende de la historia. El pasado competitivo da razones para volver más allá de un solo highlight.";
"history.story.sea_games.b1" = "La visibilidad multideportiva ayuda a que las disciplinas de nicho se sientan institucionalmente reales.";
"history.story.sea_games.b2" = "Los SEA Games ampliaron el Takraw mediante medallas, rivalidades y relatos repetibles.";
"history.story.sea_games.b3" = "La memoria competitiva es una de las herramientas más fuertes para la retención a largo plazo.";
"history.story.sea_games.accent" = "Escena";
"history.story.sea_games.gallery.1" = "El espectáculo de arena gana sentido cuando se inserta en un contexto de campeonato reconocido.";
"history.story.sea_games.gallery.2" = "La competición formal no borró la herencia; la amplificó en un escenario nuevo.";
"history.story.sea_games.gallery.3" = "Muchos espectadores modernos conocen el Takraw por la competencia antes de descubrir sus raíces.";

"trainer.scenario.1.replay.1" = "La presión nace en el carril delantero izquierdo, donde el primer toque se va apretando contra la red.";
"trainer.scenario.1.replay.2" = "Como Feeder, tu trabajo es convertir una recepción desordenada en una imagen limpia de ataque.";
"trainer.scenario.1.replay.3" = "El carril ganador es la asistencia rápida a la red que mantiene al Killer a tiempo antes de que se recomponga el bloqueo.";
"trainer.scenario.2.replay.1" = "La pelota ya vive en tu lado, así que la primera lectura trata más del equilibrio corporal que del alcance.";
"trainer.scenario.2.replay.2" = "La preparación debe conservar tu ángulo para atacar sin perder el carril.";
"trainer.scenario.2.replay.3" = "La definición por el frente derecho funciona porque usa la imagen abierta en lugar de forzar un milagro cruzado.";
"trainer.scenario.3.replay.1" = "Todo empieza en el círculo de servicio, donde el control importa más que el lucimiento.";
"trainer.scenario.3.replay.2" = "El gesto de saque debe mantener al regu ordenado para el siguiente toque, no solo generar velocidad.";
"trainer.scenario.3.replay.3" = "Sostener la línea de servicio mantiene estable la forma inicial y evita una sobre-rotación temprana.";
"trainer.scenario.4.replay.1" = "La presión en la red ya es alta, así que la primera responsabilidad es no sobrecomprometerse.";
"trainer.scenario.4.replay.2" = "Un toque de transición inteligente le compra al regu un marco más limpio en lugar de apostar por un remate bloqueado.";
"trainer.scenario.4.replay.3" = "Reiniciar hacia el centro le da a todo el equipo una oportunidad de atacar con equilibrio en el siguiente contacto.";
"trainer.scenario.5.replay.1" = "El carril izquierdo está cargado, así que leer esa compresión pronto importa.";
"trainer.scenario.5.replay.2" = "El mejor toque del Feeder abre el canal central de recuperación en vez de perseguir un golpe rápido de bajo porcentaje.";
"trainer.scenario.5.replay.3" = "Esa liberación central devuelve estructura suficiente para que el siguiente jugador vuelva a tener opciones.";
"trainer.scenario.6.replay.1" = "El punto de presión está en la cinta, donde las decisiones apresuradas suelen romper la secuencia.";
"trainer.scenario.6.replay.2" = "Un toque sereno del Feeder dobla la jugada hacia una imagen más limpia por la derecha.";
"trainer.scenario.6.replay.3" = "El objetivo por el frente derecho funciona porque reconstruye el tiempo antes de que la defensa se asiente.";
"trainer.scenario.7.replay.1" = "Como Tekong, la primera lectura es si el saque puede distorsionar la recepción hacia el carril derecho.";
"trainer.scenario.7.replay.2" = "La acción de saque debe mantener suficiente equilibrio para sostener la siguiente secuencia, no solo crear velocidad.";
"trainer.scenario.7.replay.3" = "La definición por el frente derecho se gana porque la apertura ya dobló al regu hacia ese corredor.";
"trainer.scenario.8.replay.1" = "Es un momento inestable junto a la red, así que la primera tarea es mantener vivo el rally sin perder del todo la estructura.";
"trainer.scenario.8.replay.2" = "El toque del Feeder parece conservador, pero en realidad es una recuperación de alto nivel.";
"trainer.scenario.8.replay.3" = "Usando el centro, el regu reinicia su geometría y gana otra oportunidad de atacar en mejores condiciones.";
"trainer.scenario.9.replay.1" = "La jugada comienza cargada por la derecha, lo que invita a la defensa a inclinarse demasiado hacia un solo lado.";
"trainer.scenario.9.replay.2" = "La preparación debe guardar suficiente disimulo para que el Killer ataque cruzando el cuerpo sin delatarlo demasiado pronto.";
"trainer.scenario.9.replay.3" = "La definición por el frente izquierdo aparece porque la secuencia primero vendió compromiso hacia el lado opuesto.";
"learn.topic.foundations.readingTime" = "7 min de lectura";
"learn.topic.foundations.gallery.1" = "La geometría del campo en vista superior es la forma más rápida de volver legible este deporte.";
"learn.topic.foundations.gallery.2" = "El círculo de servicio no es solo una marca: es la plataforma de lanzamiento de la presión.";
"learn.topic.foundations.gallery.3" = "Incluso la textura de la pelota influye en cómo se controla la altura y el ritmo.";
"learn.topic.foundations.timeline.1.label" = "01";
"learn.topic.foundations.timeline.1.title" = "Lee el mapa";
"learn.topic.foundations.timeline.1.body" = "Aprende el punto fijo de servicio, los dos carriles delanteros y el centro de recuperación.";
"learn.topic.foundations.timeline.2.label" = "02";
"learn.topic.foundations.timeline.2.title" = "Valora cada toque";
"learn.topic.foundations.timeline.2.body" = "Observa cómo cada contacto estabiliza la forma o acelera la presión.";

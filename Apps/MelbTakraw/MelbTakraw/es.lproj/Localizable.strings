"history.story.equipment_craft.title" = "Artesanía, material y la pelota de ratán";
"history.story.equipment_craft.summary" = "Observa cómo la cultura material moldea la identidad visual y la inteligencia táctil del deporte.";
"history.story.equipment_craft.readingTime" = "5 min de lectura";
"history.story.equipment_craft.p1" = "Pocos deportes se identifican tan rápido por un solo objeto como el Takraw por su pelota tejida. Incluso antes de entender las reglas, su textura y su patrón ya sitúan el deporte dentro de una tradición material específica.";
"history.story.equipment_craft.p2" = "Esa identidad material no es decorativa. Moldea la sensación de control, el ritmo visual del vuelo y la sensibilidad táctil que desarrollan los jugadores.";
"history.story.equipment_craft.p3" = "Desde el diseño, esto le da a Melb Takraw un objeto firma sobre el que construir iconografía, transiciones y fotografía editorial sin sentirse como una plantilla genérica.";
"history.story.equipment_craft.p4" = "En Melb Takraw, la cultura artesanal se convierte en una ventaja real de producto. Le da al sistema visual un lenguaje arraigado, premium e inseparable del propio deporte.";
"history.story.equipment_craft.b1" = "La pelota tejida es a la vez un objeto de juego y un símbolo cultural.";
"history.story.equipment_craft.b2" = "La textura del material influye en cómo el deporte se ve y se siente en movimiento.";
"history.story.equipment_craft.b3" = "La identidad artesanal le da a Melb Takraw un lenguaje visual más rico que el de los paneles deportivos intercambiables.";
"history.story.equipment_craft.accent" = "Artesanía";
"history.story.equipment_craft.gallery.1" = "La identidad material puede sostener a la vez herencia y diseño premium.";
"history.story.equipment_craft.gallery.2" = "La continuidad visual a través de los siglos ayuda a que el deporte se sienta inconfundible.";
"history.story.equipment_craft.gallery.3" = "Incluso el aprendizaje táctico se vuelve más memorable cuando se apoya en símbolos visuales potentes.";
"history.story.equipment_craft.timeline.1.label" = "Material";
"history.story.equipment_craft.timeline.1.title" = "Identidad artesanal";
"history.story.equipment_craft.timeline.1.body" = "La pelota emerge como un marcador táctil de las raíces culturales del deporte.";
"history.story.equipment_craft.timeline.2.label" = "Visual";
"history.story.equipment_craft.timeline.2.title" = "Silueta icónica";
"history.story.equipment_craft.timeline.2.body" = "Su forma tejida ayuda al Takraw a diferenciarse de otros deportes de pelota.";
"history.story.equipment_craft.timeline.3.label" = "Producto";
"history.story.equipment_craft.timeline.3.title" = "Lenguaje de diseño";
"history.story.equipment_craft.timeline.3.body" = "Las apps modernas pueden construir una marca premium a partir de señales materiales auténticas.";
"history.story.modern_game.title" = "La brecha del espectáculo moderno";
"history.story.modern_game.summary" = "El Takraw ya tiene una potencia visual de nivel mundial, pero aún faltan productos premium que enseñen a leer lo que ocurre.";
"history.story.modern_game.readingTime" = "7 min de lectura";
"history.story.modern_game.p1" = "La transmisión moderna y las redes hacen que el Takraw impacte al instante. Las acrobacias, los rescates imposibles y el timing agresivo detienen el scroll incluso en quien nunca oyó hablar del deporte.";
"history.story.modern_game.p2" = "El problema es la conversión. El espectáculo por sí solo no enseña comprensión. Sin contexto, el espectador recuerda la imagen pero no puede explicar la decisión brillante detrás.";
"history.story.modern_game.p3" = "Melb Takraw está construido exactamente para esa brecha. Traduce la energía del highlight en comprensión repetible mediante contenido editorial, explicaciones visuales de cancha y un Match Lab que obliga a pensar como jugador.";
"history.story.modern_game.p4" = "Eso le da a Melb Takraw un carril más claro que las apps copiadas de marcadores o estadísticas. Convierte una complejidad poco atendida en una experiencia premium de aprendizaje.";
"history.story.modern_game.b1" = "El Takraw ya gana atención visual; necesita mejores herramientas de interpretación.";
"history.story.modern_game.b2" = "La retención aparece cuando el espectáculo se combina con explicación.";
"history.story.modern_game.b3" = "Una app de deporte nicho gana valor cuando enseña contexto, no solo datos.";
"history.story.modern_game.accent" = "Ahora";
"history.story.modern_game.gallery.1" = "El highlight engancha, pero el valor del producto vive en la explicación.";
"history.story.modern_game.gallery.2" = "El drama televisivo crea descubrimiento, pero la comprensión aún necesita guía.";
"history.story.modern_game.gallery.3" = "Incluso un solo saque puede volverse rico cuando el usuario sabe qué mirar.";
"history.story.modern_game.timeline.1.label" = "Clip";
"history.story.modern_game.timeline.1.title" = "Llega la atención";
"history.story.modern_game.timeline.1.body" = "Los espectadores notan de inmediato el espectáculo atlético.";
"history.story.modern_game.timeline.2.label" = "Brecha";
"history.story.modern_game.timeline.2.title" = "Falta significado";
"history.story.modern_game.timeline.2.body" = "Sin interpretación, la emoción se desvanece después del impacto visual.";

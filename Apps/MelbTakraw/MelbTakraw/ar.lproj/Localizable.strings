"learn.topic.roles.p1" = "الـTekong ليس مجرد مُرسل. هذا الدور يضبط الإيقاع العاطفي وضغط الافتتاح وثقة المجموعة كلها.";
"learn.topic.roles.p2" = "الـFeeder هو مركز التفكير في الـregu. إنه يحوّل اللمسات غير المستقرة إلى بنية قابلة للهجوم.";
"learn.topic.roles.p3" = "الـKiller هو المنهي، لكن الإنهاء لا يعمل إلا لأن الدورين الأولين يصنعان التوقيت والارتفاع المناسبين.";
"learn.topic.roles.b1" = "يحدد الـTekong نغمة التبادل منذ لقطته الأولى.";
"learn.topic.roles.b2" = "الـFeeder هو العقل الصانع للعب الذي يعيد النظام تحت الضغط.";
"learn.topic.roles.b3" = "الـKiller يحوّل البنية إلى مشهد حاسم بعد تجهيز التسلسل.";
"learn.topic.matchiq.title" = "ذكاء المباراة";
"learn.topic.matchiq.summary" = "اقرأ النزعات، واستعد الشكل، وافهم متى تختار الفرق النخبوية السيطرة بدلاً من المجازفة الاستعراضية.";
"learn.topic.matchiq.p1" = "يبدو التاكراو انفجارياً، لكن قرارات النخبة تكون محافظة بذكاء في اللحظة المناسبة. تعرف الفرق القوية متى تعيد الضبط ومتى تؤخر ومتى تهاجم المسار المفتوح.";
"learn.topic.matchiq.p2" = "هنا يصبح التطبيق أكثر من موسوعة ثابتة. فهو يعلّم المستخدم كيف يتحرك الضغط داخل التبادل وكيف يكسب اللاعب الذكي وقتاً لإعادة التموضع.";
"learn.topic.matchiq.p3" = "عندما يستطيع المستخدم تفسير سبب كون الإعداد المتأخر أو الإرجاع الآمن هو القرار الأفضل، يكون قد انتقل من مشاهد سلبي إلى قارئ تكتيكي.";
"learn.topic.matchiq.b1" = "ليست كل لقطة قوية هجومية؛ كثير من لقطات النخبة هي اختيارات تثبيت ذكية.";
"learn.topic.matchiq.b2" = "شكل الجسد والنزعة قد يكشفان المسار القادم قبل حدوث اللمسة.";
"learn.topic.matchiq.b3" = "إعادة ضبط البنية قرار عالي المستوى لا قرار جبان.";
"history.explore.header" = "ادخل إلى القصص الثقافية الكاملة";
"history.detail.keypoints" = "أهم الخلاصات التاريخية";
"history.story.origins.title" = "الأصول والتراث المشترك";
"history.story.origins.summary" = "تتبّع كيف تطور اللعب المعتمد على الركل إلى واحدة من أكثر رياضات جنوب شرق آسيا الحديثة تميزاً.";
"history.story.origins.p1" = "قبل تقنين التاكراو للمنافسة الحديثة، كانت أشكال اللعب بالكرة المعتمدة على القدم موجودة بالفعل في الساحات والقرى والتجمعات المجتمعية عبر المنطقة.";
"history.story.origins.p2" = "تكمن قوة قصة الأصل في مزجها بين الطقس والمهارة واللعب الاجتماعي. وقد ساهمت الكرة المنسوجة ومنطق الملعب المدمج والسياق الجماعي في تشكيل هوية اللعبة.";
"history.story.origins.p3" = "بالنسبة للجمهور العالمي، يمنح هذا التاريخ الرياضة عمقاً يتجاوز المقاطع السريعة، ويجعل Melb Takraw جسراً بين التراث وحرفة الملعب والفهم الحديث.";
"history.story.origins.b1" = "كان اللعب الشبيه بالتاكراو في بداياته إقليمياً وجماعياً قبل أن يُقنّن.";
"history.story.origins.b2" = "ما زالت الثقافة الحرفية، وخصوصاً الكرة المنسوجة، جزءاً من هوية الرياضة.";
"history.story.origins.b3" = "يمنح التاريخ الجمهور الجديد سبباً للاهتمام بما هو أبعد من اللقطات المنتشرة.";
"history.story.regional.title" = "القوة الإقليمية والهوية الوطنية";
"history.story.regional.summary" = "اكتشف كيف جعلت تايلاند وماليزيا والدول المجاورة التاكراو رياضة تنافسية مرئية وعميقة الحضور.";
"history.story.regional.p1" = "أصبحت تايلاند أحد أهم بيوت التاكراو الحديثة عبر التكرار والظهور والثقة العامة، لا عبر النتائج فقط.";
"history.story.regional.p2" = "كما لعبت ماليزيا دوراً حاسماً في تشكيل المنافسات المنظمة واستمرار الجمهور، وتحولت الرياضة إلى معيار إقليمي للرشاقة والسيطرة.";
"history.story.regional.p3" = "هذا التركّز الإقليمي مهم استراتيجياً للتطبيق، لأنه يجعل المنتج متخصصاً عالمياً لكنه شديد الصلة في أسواقه الأقوى.";
"history.story.regional.b1" = "منحت القوة الإقليمية الرياضة استمرارية قبل أن تلحق بها السرديات الرقمية العالمية.";
"history.story.regional.b2" = "ساعدت الهوية الوطنية والفخر المحلي في الحفاظ على اهتمام الجمهور.";
"history.story.regional.b3" = "يمكن للمنتج متعدد اللغات أن يصل بين المعاقل الحالية وأسواق الاكتشاف الجديدة.";
"history.story.modern.title" = "فجوة المشهد الحديث";
"history.story.modern.summary" = "يمتلك التاكراو اليوم دراما بصرية عالمية المستوى، لكنه ما زال يفتقر إلى منتجات رقمية مميزة تشرحه جيداً.";
"history.story.modern.p1" = "جعل البث الحديث ووسائل التواصل الاجتماعي التاكراو لافتاً فوراً: حركات أكروباتية وإنقاذات مستحيلة وتوقيت حاد يلفت الانتباه بسرعة.";
"history.story.modern.p2" = "لكن المشكلة هي التحويل. فالمشهد وحده لا يعلّم المشاهد ما الذي حدث أو لماذا كان القرار ذكياً. وهنا يأتي دور Melb Takraw.";
"history.story.modern.p3" = "من خلال الجمع بين الصور والمحتوى التحريري والمدرب البديهي، يمكن للتطبيق أن يصبح طبقة تمهيدية لفهم الرياضة نفسها.";
"history.story.modern.b1" = "يفوز التاكراو بالانتباه بصرياً بالفعل، لكنه ما زال يحتاج إلى أدوات تفسير.";
"history.story.modern.b2" = "يعمل التعليم والاستعراض معاً بأفضل صورة عندما تقود الواجهة عين المستخدم.";
"history.story.modern.b3" = "تصبح منتجات الرياضات المتخصصة قيّمة عندما تعلّم السياق لا الحقائق فقط.";

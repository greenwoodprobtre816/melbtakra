"history.story.sea_games.title" = "SEA Games and Competitive Legitimacy";
"history.story.sea_games.summary" = "Track how multi-sport visibility helped Takraw move from regional familiarity to wider competitive recognition.";
"history.story.sea_games.readingTime" = "6 min read";
"history.story.sea_games.p1" = "Multi-sport events matter because they change how a discipline is framed in the public imagination. When Takraw appears within a larger competitive ecosystem, it is seen not only as a cultural practice but as a legitimate elite sport with measurable prestige.";
"history.story.sea_games.p2" = "The SEA Games provided exactly that stage. The event gave Takraw a repeating structure for comparison, public storytelling, and national investment. It also widened the circle of viewers who might first encounter the sport through a medal narrative before learning its deeper history.";
"history.story.sea_games.p3" = "This visibility helped stabilize pathways for athletes and audiences alike. Consistent competition creates heroes, rivalries, and memory, which are crucial ingredients in turning an impressive sport into a retained audience habit.";
"history.story.sea_games.p4" = "For Melb Takraw, this matters because product retention often depends on story. Competition history gives users recurring reasons to return to the sport beyond a single highlight reel.";
"history.story.sea_games.b1" = "Multi-sport visibility helps niche disciplines feel institutionally real.";
"history.story.sea_games.b2" = "The SEA Games amplified Takraw through medals, rivalries, and repeatable storytelling.";
"history.story.sea_games.b3" = "Competitive memory is one of the strongest tools for long-term audience retention.";
"history.story.sea_games.accent" = "Stage";
"history.story.sea_games.gallery.1" = "Arena spectacle gains meaning when it sits inside a recognized championship context.";
"history.story.sea_games.gallery.2" = "Formal competition did not erase heritage; it amplified it on a new stage.";
"history.story.sea_games.gallery.3" = "Modern viewers often meet Takraw through competition before learning its roots.";

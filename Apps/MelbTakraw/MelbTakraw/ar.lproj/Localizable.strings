"learn.topic.matchiq.timeline.1.title" = "Read the pressure point";
"learn.topic.matchiq.timeline.1.body" = "Find the athlete or zone where the rally is becoming unstable.";
"learn.topic.matchiq.timeline.2.label" = "02";
"learn.topic.matchiq.timeline.2.title" = "Preserve optionality";
"learn.topic.matchiq.timeline.2.body" = "Strong teams choose touches that keep multiple next actions alive.";

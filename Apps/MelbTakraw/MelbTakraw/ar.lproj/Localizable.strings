"history.story.equipment_craft.title" = "Craft, Material, and the Rattan Ball";
"history.story.equipment_craft.summary" = "Look at how material culture shapes the visual identity and tactile intelligence of the sport.";
"history.story.equipment_craft.readingTime" = "5 min read";
"history.story.equipment_craft.p1" = "Few sports are identified so quickly by a single object as Takraw is by its woven ball. Even before a viewer understands the rules, the texture, pattern, and handmade associations of the ball signal that this sport comes from a specific material tradition.";
"history.story.equipment_craft.p2" = "That material identity is not merely decorative. It shapes the feel of control, the visual rhythm of flight, and the kind of tactile sensitivity players develop. The ball is part of the sport's intelligence, not just its branding.";
"history.story.equipment_craft.p3" = "From a design perspective, this gives Melb Takraw a signature object to build around. The woven ball can anchor iconography, transitions, editorial photography, and tactile UI moments without ever feeling borrowed from an off-the-shelf sports template.";
"history.story.equipment_craft.p4" = "In Melb Takraw, craft culture becomes a true product edge. It gives the app a visual language that feels grounded, premium, and unmistakably tied to the sport's own material identity.";
"history.story.equipment_craft.b1" = "The woven ball is both a gameplay object and a cultural symbol.";
"history.story.equipment_craft.b2" = "Material texture influences how the sport looks and feels in motion.";
"history.story.equipment_craft.b3" = "Craft identity gives Melb Takraw a richer visual language than interchangeable sports dashboards.";
"history.story.equipment_craft.accent" = "Craft";
"history.story.equipment_craft.gallery.1" = "Material identity can carry both heritage and premium design language.";
"history.story.equipment_craft.gallery.2" = "Visual continuity across centuries helps the sport feel unmistakable.";
